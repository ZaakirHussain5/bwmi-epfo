# Nidhi assistant (server-only)

# Required for OpenAI-powered chat, voice transcription, and spoken replies.
# Typed chat and transcribed voice both run inference on OPENAI_MODEL.
OPENAI_API_KEY=

# Chat / voice inference model. Default is gpt-5.6.
OPENAI_MODEL=gpt-5.6

# Speech-to-text model used by the left-rail voice control.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional text-to-speech (not required for chat/navigation).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
